---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import portrait from '../assets/about/portrait.webp';
import Icon from '../components/Icon.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ArticleRow from '../components/ArticleRow.astro';
import { content } from '../lib/content';
import { withBase } from '../lib/url';
import profile from '../data/profile.json';
import { tools } from '../data/tools';
const { projects, articles } = await content();
const featured = projects.filter((p) => p.data.featured).slice(0, 3);
const wave = Array.from(
  { length: 201 },
  (_, i) => `${i ? 'L' : 'M'}${30 + i * 1.9},${109 - 51 * Math.sin((i / 200) * Math.PI * 4)}`,
).join(' ');
---

<Layout>
  <div class="home">
    <section class="hero">
      <div class="hero-copy">
        <div class="kicker">EE / CS · 个人技术空间</div>
        <h1>
          把想法做成
          <br />
          可以运行的作品<span>。</span>
        </h1>
        <p>{profile.intro}</p>
        <div class="button-row">
          <a class="button primary" href={withBase('/projects/')}>
            查看项目 <Icon name="arrow" size={17} />
          </a>
          <a class="button" href={withBase('/tools/')}>
            打开工具箱 <Icon name="code" size={17} />
          </a>
        </div>
        <div class="hero-directions">
          {profile.directions.slice(1).map((d, i) => (
            <>
              <span>{d}</span>
              {i < profile.directions.length - 2 && <i />}
            </>
          ))}
        </div>
      </div>
      <div class="signal-demo">
        <div class="demo-top">
          <span>
            <i />
            SIGNAL PLAYGROUND
          </span>
          <span class="mono">01 / 交互演示</span>
        </div>
        <div class="demo-formula">
          y = sin(2πfx)<span>试着改变一点频率。</span>
        </div>
        <svg viewBox="0 0 440 210" role="img" aria-label="可调频率的数学正弦波，横轴为归一化位置">
          <defs>
            <pattern id="wave-grid" width="38" height="30" patternUnits="userSpaceOnUse">
              <path d="M 38 0 L 0 0 0 30" fill="none" stroke="currentColor" stroke-width=".5" />
            </pattern>
          </defs>
          <rect x="28" y="20" width="384" height="158" fill="url(#wave-grid)" class="wave-grid" />
          <path d="M28 109h384" class="wave-axis" />
          <path id="hero-wave" d={wave} class="wave-path" />
          <text x="28" y="198">
            0
          </text>
          <text x="408" y="198">
            1
          </text>
          <text x="180" y="198">
            归一化位置
          </text>
        </svg>
        <div class="frequency-control">
          <label for="hero-frequency">
            频率{' '}
            <span class="mono">
              <output id="hero-frequency-value">2.0</output> 周期
            </span>
          </label>
          <input id="hero-frequency" type="range" min="0.5" max="4" step="0.1" value="2" />
          <div class="range-labels mono">
            <span>0.5</span>
            <span>4.0</span>
          </div>
        </div>
        <div class="demo-bottom">
          <span>数学演示 · 非传感器数据</span>
          <a href={withBase('/lab/signal-studio/')}>
            进入信号实验室 <span>↗</span>
          </a>
        </div>
      </div>
    </section>
    <section class="home-section" aria-labelledby="featured-title">
      <div class="section-heading">
        <div>
          <span class="section-number">01 / SELECTED WORK</span>
          <h2 id="featured-title">从问题，到作品</h2>
        </div>
        <a href={withBase('/projects/')}>
          全部项目 <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="featured-grid">
        {featured.map((p, i) => (
          <ProjectCard project={p} featured={i === 0} />
        ))}
      </div>
    </section>
    <section class="home-section tools-section" aria-labelledby="tools-title">
      <div class="section-heading">
        <div>
          <span class="section-number">02 / USEFUL TOOLS</span>
          <h2 id="tools-title">打开就能用的小工具</h2>
        </div>
        <a href={withBase('/tools/')}>进入工具箱 ↗</a>
      </div>
      <div class="grid-2">
        {tools.map((t, i) => (
          <article class="tool-preview">
            <div class="tool-icon">
              <Icon name={i ? 'chart' : 'file'} size={24} />
            </div>
            <div>
              <div class="tool-eyebrow">
                {t.format}
                <span>本地处理</span>
              </div>
              <h3>
                <a href={withBase(t.path)}>{t.title}</a>
              </h3>
              <p>{t.summary}</p>
            </div>
            <a class="tool-arrow" href={withBase(t.path)} aria-label={`打开${t.title}`}>
              ↗
            </a>
          </article>
        ))}
      </div>
      <p class="tools-privacy">
        <Icon name="shield" size={14} /> 无需注册，文件在当前浏览器中处理。
        <a href={withBase('/privacy/')}>了解数据流</a>
      </p>
    </section>
    <section class="home-section" aria-labelledby="articles-title">
      <div class="section-heading">
        <div>
          <span class="section-number">03 / NOTES & IDEAS</span>
          <h2 id="articles-title">记录过程，也分享方法</h2>
        </div>
        <a href={withBase('/articles/')}>全部文章 ↗</a>
      </div>
      <div class="article-list">
        {articles.slice(0, 3).map((article) => (
          <ArticleRow article={article} />
        ))}
      </div>
    </section>
    <section class="about-strip">
      <Image
        src={portrait}
        alt="喻锦权的个人形象照"
        width={180}
        format="webp"
        class="about-portrait"
      />
      <div class="about-strip-copy">
        <span class="section-number">A LITTLE ABOUT ME</span>
        <h2>保持好奇，把事情弄明白。</h2>
        <p>从电赛里的小模块，到光纤光栅解调仪，也记录实验室之外的生活。</p>
      </div>
      <a class="text-link" href={withBase('/about/')}>
        认识一下 <Icon name="arrow" size={18} />
      </a>
    </section>
  </div>
  <script>
    const slider = document.querySelector<HTMLInputElement>('#hero-frequency');
    slider?.addEventListener('input', () => {
      const f = Number(slider.value);
      document.querySelector('#hero-frequency-value')!.textContent = f.toFixed(1);
      document
        .querySelector('#hero-wave')!
        .setAttribute(
          'd',
          Array.from(
            { length: 201 },
            (_, i) =>
              `${i ? 'L' : 'M'}${30 + i * 1.9},${109 - 51 * Math.sin((i / 200) * Math.PI * 2 * f)}`,
          ).join(' '),
        );
    });
  </script>
</Layout>
<style>
  .home {
    padding-bottom: 64px;
  }
  .hero {
    display: grid;
    grid-template-columns: 1.16fr 1fr;
    gap: 76px;
    align-items: center;
    padding: 62px 0 57px;
  }
  .hero h1 {
    font-size: clamp(2rem, 3.7vw, 3.35rem);
    font-weight: 650;
    line-height: 1.38;
    letter-spacing: -0.05em;
    margin-bottom: 22px;
  }
  .hero h1 span {
    color: var(--accent);
  }
  .hero-copy > p {
    max-width: 500px;
    color: var(--muted);
    font-size: 14px;
    line-height: 1.95;
    margin-bottom: 28px;
  }
  .hero .button-row {
    gap: 12px;
  }
  .hero-directions {
    margin-top: 25px;
    display: flex;
    align-items: center;
    gap: 11px;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 11px;
  }
  .hero-directions i {
    width: 2px;
    height: 2px;
    background: var(--control-border);
    border-radius: 50%;
  }
  .signal-demo {
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    padding: 20px 22px 0;
    box-shadow: 0 8px 26px #17233404;
    transform: rotate(-0.5deg);
  }
  .demo-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    font-family: Consolas, monospace;
    font-size: 9px;
    color: var(--muted);
    letter-spacing: 0.07em;
  }
  .demo-top > span:first-child {
    display: flex;
    align-items: center;
    gap: 7px;
  }
  .demo-top i {
    width: 5px;
    height: 5px;
    background: var(--accent);
    border-radius: 50%;
  }
  .demo-formula {
    margin-top: 19px;
    font:
      18px Consolas,
      monospace;
    letter-spacing: -0.02em;
  }
  .demo-formula span {
    display: block;
    font: 11px system-ui;
    color: var(--muted);
    margin-top: 7px;
  }
  .signal-demo svg {
    width: 100%;
    display: block;
    height: 178px;
    overflow: visible;
  }
  .wave-grid {
    color: var(--control-border);
    opacity: 0.28;
  }
  .wave-axis {
    stroke: var(--control-border);
    stroke-width: 0.7;
  }
  .wave-path {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.4;
    stroke-linecap: round;
  }
  .signal-demo svg text {
    font: 9px system-ui;
    fill: var(--muted);
  }
  .frequency-control {
    padding: 5px 4px 16px;
  }
  .frequency-control label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
  }
  .frequency-control label span {
    color: var(--accent);
    font-size: 12px;
  }
  .frequency-control input {
    height: 23px;
    margin: 5px 0 0;
  }
  .range-labels {
    display: flex;
    justify-content: space-between;
    font-size: 9px;
    color: var(--muted);
  }
  .demo-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    border-top: 1px solid var(--border);
    margin: 0 -22px;
    padding: 12px 19px;
    font-size: 10px;
    color: var(--muted);
    background: var(--surface-subtle);
    border-radius: 0 0 12px 12px;
  }
  .demo-bottom a {
    font-size: 11px;
    text-decoration: none;
  }
  .demo-bottom a span {
    margin-left: 6px;
  }
  .home-section {
    padding: 30px 0 36px;
  }
  .featured-grid {
    display: grid;
    grid-template-columns: 1.23fr 1fr 1fr;
    gap: 20px;
    align-items: stretch;
  }
  .featured-grid :global(.project-card) {
    display: flex;
    flex-direction: column;
  }
  .featured-grid :global(.project-visual) {
    min-height: 204px;
    display: flex;
    flex-direction: column;
  }
  .featured-grid :global(.project-visual svg) {
    flex: 1;
    min-height: 160px;
  }
  .featured-grid :global(.featured .project-visual) {
    min-height: 204px;
  }
  .featured-grid :global(.featured .project-visual svg) {
    height: 170px;
  }
  .featured-grid :global(.featured .project-copy) {
    padding: 20px 22px 22px;
  }
  .featured-grid :global(.featured h3) {
    font-size: 18px;
  }
  .tool-preview {
    position: relative;
    display: grid;
    grid-template-columns: 48px 1fr;
    gap: 18px;
    padding: 25px 25px 20px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface);
  }
  .tool-icon {
    height: 46px;
    width: 46px;
    display: grid;
    place-items: center;
    background: var(--accent-subtle);
    color: var(--accent);
    border-radius: 9px;
  }
  .tool-eyebrow {
    font:
      10px Consolas,
      monospace;
    color: var(--muted);
    margin-bottom: 8px;
    display: flex;
    gap: 12px;
    align-items: center;
  }
  .tool-eyebrow span {
    font: 10px system-ui;
    color: var(--success);
  }
  .tool-preview h3 {
    font-size: 17px;
    margin-bottom: 8px;
  }
  .tool-preview h3 a {
    color: var(--text);
    text-decoration: none;
  }
  .tool-preview p {
    font-size: 12px;
    color: var(--muted);
    margin: 0;
    max-width: 370px;
    padding-right: 12px;
  }
  .tool-arrow {
    position: absolute;
    right: 21px;
    top: 24px;
    text-decoration: none;
    color: var(--muted);
  }
  .tools-privacy {
    display: flex;
    gap: 7px;
    align-items: center;
    font-size: 11px;
    color: var(--muted);
    margin: 14px 0 0;
  }
  .tools-privacy a {
    color: var(--muted);
    margin-left: 3px;
  }
  .about-strip {
    margin-top: 38px;
    padding: 31px 0 0;
    border-top: 1px solid var(--border);
    display: flex;
    gap: 24px;
    align-items: center;
  }
  .about-strip :global(.about-portrait) {
    flex: none;
    width: 68px;
    height: 82px;
    object-fit: cover;
    object-position: 50% 35%;
    border: 1px solid var(--border);
    border-radius: 7px;
  }
  .about-strip-copy {
    flex: 1;
    min-width: 190px;
  }
  .about-strip h2 {
    font-size: 21px;
    margin: 6px 0 8px;
  }
  .about-strip p {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
  .about-strip > .text-link {
    margin-left: auto;
  }
  @media (max-width: 1050px) {
    .hero {
      gap: 38px;
      padding-top: 45px;
    }
    .featured-grid {
      gap: 15px;
    }
    .featured-grid :global(.project-copy),
    .featured-grid :global(.featured .project-copy) {
      padding: 18px;
    }
    .featured-grid :global(h3),
    .featured-grid :global(.featured h3) {
      font-size: 16px;
    }
    .featured-grid :global(.project-meta) {
      flex-wrap: wrap;
    }
    .tool-preview {
      padding: 23px 18px;
      gap: 13px;
    }
  }
  @media (max-width: 760px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 31px;
      padding: 38px 0 24px;
    }
    .hero h1 {
      font-size: 34px;
      max-width: 100%;
      line-height: 1.4;
    }
    .hero-copy > p {
      font-size: 14px;
      max-width: 500px;
    }
    .kicker {
      margin-bottom: 18px;
    }
    .hero-directions {
      margin-top: 20px;
    }
    .signal-demo {
      transform: none;
      max-width: 500px;
      width: 100%;
      padding: 18px 19px 0;
    }
    .demo-bottom {
      margin: 0 -19px;
    }
    .signal-demo svg {
      height: 163px;
    }
    .demo-formula {
      margin-top: 15px;
    }
    .home-section {
      padding: 25px 0;
    }
    .section-heading a {
      font-size: 12px;
      white-space: nowrap;
    }
    .section-number {
      font-size: 9px;
    }
    .featured-grid {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .featured-grid :global(.project-visual),
    .featured-grid :global(.featured .project-visual) {
      min-height: 190px;
    }
    .featured-grid :global(h3),
    .featured-grid :global(.featured h3) {
      font-size: 19px;
    }
    .featured-grid :global(.project-copy),
    .featured-grid :global(.featured .project-copy) {
      padding: 20px;
    }
    .tool-preview {
      padding: 23px 20px;
      grid-template-columns: 40px 1fr;
      gap: 14px;
    }
    .tool-icon {
      width: 40px;
      height: 40px;
    }
    .tools-privacy {
      font-size: 10px;
      flex-wrap: wrap;
    }
    .about-strip {
      gap: 16px;
      flex-wrap: wrap;
      margin-top: 20px;
    }
    .about-strip h2 {
      font-size: 18px;
    }
    .about-strip > .text-link {
      margin-left: 84px;
    }
    .home {
      padding-bottom: 40px;
    }
  }
  @media (max-width: 360px) {
    .hero h1 {
      font-size: 30px;
    }
    .demo-bottom {
      font-size: 9px;
      padding: 11px 15px;
    }
    .demo-bottom a {
      font-size: 10px;
    }
    .section-heading h2 {
      font-size: 21px;
    }
    .about-strip :global(.about-portrait) {
      display: none;
    }
    .about-strip > .text-link {
      margin-left: 0;
    }
  }
</style>
