{
  "name": "jinquan-space",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "prebuild": "node scripts/generate-notices.mjs",
    "build": "astro build",
    "postbuild": "node scripts/check-links.mjs && node scripts/check-bundle.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "test:e2e": "playwright test tests/e2e",
    "test:a11y": "playwright test --project=chromium tests/accessibility",
    "test:basepath": "node scripts/test-build.mjs base",
    "test:public": "node scripts/test-build.mjs public",
    "test:links": "node scripts/check-links.mjs",
    "test:bundle": "node scripts/check-bundle.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.2",
    "astro": "7.3.8",
    "echarts": "6.1.0",
    "papaparse": "5.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/papaparse": "5.5.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
